generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  WORKER
  SALON
  ADMIN
}

enum Availability {
  NOW
  TODAY
  WEEKEND
  NOT_AVAILABLE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  TEMPORARY
  WEEKEND
  EMERGENCY
  CONTRACT
  SEASONAL
  APPRENTICESHIP
  FREELANCE
}

enum ListingType {
  JOB
  RENTAL
  SPACE
}

enum MediaType {
  IMAGE
  VIDEO
}

enum AppStatus {
  PENDING
  VIEWED
  ACCEPTED
  DECLINED
}

enum ReportType {
  FAKE_PROFILE
  NO_SHOW
  INAPPROPRIATE
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum Platform {
  IOS
  ANDROID
}

enum ChatRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NotificationType {
  NEW_MESSAGE
  NEW_APPLICATION
  APPLICATION_ACCEPTED
  APPLICATION_DECLINED
  CHAT_REQUEST
  CHAT_REQUEST_ACCEPTED
  NEW_JOB_MATCH
  REVIEW_RECEIVED
  SYSTEM
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  phone        String?
  role         Role     @default(WORKER)
  createdAt    DateTime @default(now())

  workerProfile WorkerProfile?
  salonProfile  SalonProfile?
  isActive      Boolean  @default(true)
  sentMessages  Message[]                @relation("SentMessages")
  conversations ConversationParticipant[]
  reportsGiven    Report[] @relation("ReportGiver")
  reportsReceived Report[] @relation("ReportReceiver")
  devices         UserDevice[]
  passwordResets  PasswordReset[]
  sentRequests     ChatRequest[] @relation("SentRequests")
  receivedRequests ChatRequest[] @relation("ReceivedRequests")
  reviewsWritten   Review[]      @relation("ReviewsWritten")
  reviewsReceived  Review[]      @relation("ReviewsReceived")
  notifications    Notification[]
  savedJobs        SavedJob[]
}

model WorkerProfile {
  id              String           @id @default(uuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id])
  name            String
  bio             String?
  photoUrl        String?
  specialties     String[]
  experienceYears Int              @default(0)
  radiusMiles     Int              @default(15)
  availability    Availability     @default(NOT_AVAILABLE)
  location        Unsupported("geography(Point, 4326)")?
  languages       String[]
  expectedPay     String?
  rateRange       String?
  rateNote        String?
  workerPayType   String?
  payMin          Float?
  payMax          Float?
  payPercentage   Float?
  seatRate        Float?
  employmentTypes EmploymentType[]
  isVerified      Boolean          @default(false)
  stripeSessionId String?
  licenseNumber        String?
  availabilitySchedule Json?
  city            String?
  state           String?
  country         String?
  placeId         String?
  formattedAddress String?
  rating          Float            @default(0)
  reviewCount     Int              @default(0)

  portfolioItems  PortfolioItem[]
  jobApplications JobApplication[]

  @@index([availability])
  @@index([isVerified])
}

model SalonProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  name        String
  description String?
  photoUrls   String[]
  specialties String[]
  isHiring    Boolean  @default(false)
  isVerified  Boolean  @default(false)
  ein         String?
  city        String?
  state       String?
  country     String?
  placeId     String?
  formattedAddress String?
  location    Unsupported("geography(Point, 4326)")?
  rating      Float    @default(0)
  reviewCount Int      @default(0)

  jobPosts JobPost[]
}

model JobPost {
  id              String         @id @default(uuid())
  salonId         String
  salon           SalonProfile   @relation(fields: [salonId], references: [id])
  title           String
  description     String
  specialty       String
  payStructure    String
  type            EmploymentType
  listingType     ListingType    @default(JOB)
  isUrgent        Boolean        @default(false)
  city            String?
  state           String?
  country         String?
  placeId         String?
  formattedAddress String?
  location        Unsupported("geography(Point, 4326)")?
  expiresAt       DateTime
  createdAt       DateTime       @default(now())
  isActive        Boolean        @default(true)
  spacePhotos     String[]
  spaceSize       String?
  spaceAmenities  String[]
  rentalDeposit   Float?
  availableFrom   DateTime?
  jobPayType      String?
  payMin          Float?
  payMax          Float?
  payPercentage   Float?
  seatRate        Float?
  payNote         String?

  applications JobApplication[]
  savedBy       SavedJob[]

  @@index([isActive, expiresAt])
  @@index([salonId, isActive])
  @@index([listingType, isActive])
}

model SavedJob {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       JobPost  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
  @@index([userId])
}

model JobApplication {
  id        String        @id @default(uuid())
  jobId     String
  job       JobPost       @relation(fields: [jobId], references: [id])
  workerId  String
  worker    WorkerProfile @relation(fields: [workerId], references: [id])
  status    AppStatus     @default(PENDING)
  createdAt DateTime      @default(now())
}

model PortfolioItem {
  id        String        @id @default(uuid())
  workerId  String
  worker    WorkerProfile @relation(fields: [workerId], references: [id])
  mediaUrl  String
  type      MediaType
  caption   String?
  createdAt DateTime      @default(now())
}

model Conversation {
  id           String                    @id @default(uuid())
  participants ConversationParticipant[]
  messages     Message[]
  chatRequest  ChatRequest?
  createdAt    DateTime                  @default(now())
}

model ConversationParticipant {
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  content        String?
  mediaUrl       String?
  createdAt      DateTime     @default(now())
  isRead         Boolean      @default(false)
  isSystem       Boolean      @default(false)

  @@index([conversationId, createdAt])
  @@index([senderId, isRead])
}

model UserDevice {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  expoPushToken String
  platform      Platform
  updatedAt     DateTime @updatedAt

  @@unique([userId, expoPushToken])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model ChatRequest {
  id             String            @id @default(cuid())
  senderId       String
  receiverId     String
  status         ChatRequestStatus @default(PENDING)
  messageCount   Int               @default(0)
  conversationId String?           @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  sender         User              @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver       User              @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  conversation   Conversation?     @relation(fields: [conversationId], references: [id])

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
}

model Review {
  id        String    @id @default(cuid())
  rating    Int
  comment   String?
  reply     String?
  repliedAt DateTime?
  authorId  String
  subjectId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  author  User @relation("ReviewsWritten", fields: [authorId], references: [id], onDelete: Cascade)
  subject User @relation("ReviewsReceived", fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([authorId, subjectId])
  @@index([subjectId])
}

model Report {
  id         String       @id @default(uuid())
  reporterId String
  reporter   User         @relation("ReportGiver", fields: [reporterId], references: [id])
  reportedId String
  reported   User         @relation("ReportReceiver", fields: [reportedId], references: [id])
  type       ReportType
  reason     String?
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  @@index([reportedId, status])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}
