generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  WORKER
  SALON
  ADMIN
}

enum Availability {
  NOW
  TODAY
  WEEKEND
  NOT_AVAILABLE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  TEMPORARY
  WEEKEND
  EMERGENCY
  CONTRACT
  SEASONAL
  APPRENTICESHIP
  FREELANCE
}

enum ListingType {
  JOB
  RENTAL
  SPACE
}

enum MediaType {
  IMAGE
  VIDEO
  TEXT
}

enum StoryVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum AppStatus {
  PENDING
  VIEWED
  ACCEPTED
  DECLINED
}

enum ReportType {
  FAKE_PROFILE
  NO_SHOW
  INAPPROPRIATE
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum Platform {
  IOS
  ANDROID
}

enum ChatRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum AccountType {
  CLIENT
  PROFESSIONAL
  SALON
}

enum BookingStatus {
  PENDING_PAYMENT
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PostType {
  PHOTO
  VIDEO
  BEFORE_AFTER
  TEXT
}

enum NotificationType {
  NEW_MESSAGE
  NEW_APPLICATION
  APPLICATION_ACCEPTED
  APPLICATION_DECLINED
  CHAT_REQUEST
  CHAT_REQUEST_ACCEPTED
  NEW_JOB_MATCH
  REVIEW_RECEIVED
  STORY_REPLY
  STORY_LIKE
  NEW_FOLLOWER
  NEW_STORY
  SYSTEM
  // Booking notifications
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_REMINDER
  BOOKING_CANCELLED
  BOOKING_RESCHEDULED
  BOOKING_COMPLETED
  BOOKING_NO_SHOW
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id               String      @id @default(uuid())
  email            String      @unique
  passwordHash     String?
  phone            String?
  role             Role        @default(WORKER)
  accountType      AccountType?
  bookingProfileId String?
  createdAt        DateTime    @default(now())
  isOnline         Boolean     @default(false)
  lastSeenAt       DateTime?

  workerProfile  WorkerProfile?
  salonProfile   SalonProfile?
  clientProfile  ClientProfile?
  isActive       Boolean  @default(true)
  sentMessages  Message[]                @relation("SentMessages")
  deletedMessages DeletedMessage[]
  conversations ConversationParticipant[]
  reportsGiven    Report[] @relation("ReportGiver")
  reportsReceived Report[] @relation("ReportReceiver")
  devices         UserDevice[]
  passwordResets  PasswordReset[]
  sentRequests     ChatRequest[] @relation("SentRequests")
  receivedRequests ChatRequest[] @relation("ReceivedRequests")
  reviewsWritten   Review[]      @relation("ReviewsWritten")
  reviewsReceived  Review[]      @relation("ReviewsReceived")
  notifications    Notification[]
  savedJobs        SavedJob[]
  savedWorkers     SavedWorker[]
  stories          Story[]
  storyViews       StoryView[]
  storyLikes       StoryLike[]
  storyReplies     StoryReply[]
  followersCount   Int      @default(0)
  followingCount   Int      @default(0)
  followers        Follow[] @relation("FollowTarget")
  following        Follow[] @relation("FollowSource")
  posts            Post[]
  postLikes        PostLike[]
  comments         Comment[]
  highlights       StoryHighlight[]
}

model WorkerProfile {
  id              String           @id @default(uuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id])
  name            String
  bio             String?
  photoUrl        String?
  specialties     String[]
  experienceYears Int              @default(0)
  radiusMiles     Int              @default(15)
  availability    Availability     @default(NOT_AVAILABLE)
  location        Unsupported("geography(Point, 4326)")?
  languages       String[]
  expectedPay     String?
  rateRange       String?
  rateNote        String?
  workerPayType   String?
  payMin          Float?
  payMax          Float?
  payPercentage   Float?
  seatRate        Float?
  employmentTypes EmploymentType[]
  isVerified      Boolean          @default(false)
  stripeSessionId String?
  licenseNumber        String?
  availabilitySchedule Json?
  city            String?
  state           String?
  country         String?
  placeId         String?
  formattedAddress String?
  rating          Float            @default(0)
  reviewCount     Int              @default(0)
  // Booking capabilities
  acceptsBookings        Boolean  @default(false)
  homeServiceEnabled     Boolean  @default(false)
  travelServiceEnabled   Boolean  @default(false)
  travelRadius           Int?
  travelFee              Float?
  availabilityEnabled    Boolean  @default(false)
  stripeAccountId        String?
  stripeConnectEnabled   Boolean  @default(false)
  instantBooking         Boolean  @default(false)
  requiresDeposit        Boolean  @default(false)
  cancellationWindowHours Int?
  rescheduleWindowHours  Int?
  lateFeeEnabled         Boolean  @default(false)
  lateFeeAmount          Float?

  portfolioItems  PortfolioItem[]
  jobApplications JobApplication[]
  savedBy         SavedWorker[]
  salonStaff      SalonStaff[]

  @@index([availability])
  @@index([isVerified])
  @@index([acceptsBookings])
}

model SalonProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  name        String
  description String?
  photoUrls   String[]
  specialties String[]
  isHiring    Boolean  @default(false)
  isVerified  Boolean  @default(false)
  ein         String?
  city        String?
  state       String?
  country     String?
  placeId     String?
  formattedAddress String?
  location    Unsupported("geography(Point, 4326)")?
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  // Booking capabilities
  acceptsBookings      Boolean @default(false)
  bookingProfileId     String?
  stripeAccountId      String?
  stripeConnectEnabled Boolean @default(false)
  instantBooking       Boolean @default(false)
  requiresDeposit      Boolean @default(false)
  cancellationWindowHours Int?
  rescheduleWindowHours   Int?
  lateFeeEnabled       Boolean @default(false)
  lateFeeAmount        Float?

  jobPosts JobPost[]
  staff    SalonStaff[]
}

model SalonStaff {
  id          String    @id @default(uuid())
  salonId     String
  salon       SalonProfile   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  workerId    String
  worker      WorkerProfile  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  status      String    @default("INVITED") // INVITED | ACTIVE | REMOVED | DECLINED
  note        String?
  invitedAt   DateTime  @default(now())
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([salonId, workerId])
  @@index([salonId])
  @@index([workerId])
}

model ClientProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  phone            String?
  photoUrl         String?
  bio              String?
  city             String?
  state            String?
  country          String?
  placeId          String?
  formattedAddress String?
  preferredSpecialties String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

model JobPost {
  id              String         @id @default(uuid())
  salonId         String
  salon           SalonProfile   @relation(fields: [salonId], references: [id])
  title           String
  description     String
  specialty       String
  payStructure    String
  type            EmploymentType
  listingType     ListingType    @default(JOB)
  isUrgent        Boolean        @default(false)
  city            String?
  state           String?
  country         String?
  placeId         String?
  formattedAddress String?
  location        Unsupported("geography(Point, 4326)")?
  expiresAt       DateTime
  createdAt       DateTime       @default(now())
  isActive        Boolean        @default(true)
  spacePhotos     String[]
  spaceSize       String?
  spaceAmenities  String[]
  rentalDeposit   Float?
  availableFrom   DateTime?
  jobPayType      String?
  payMin          Float?
  payMax          Float?
  payPercentage   Float?
  seatRate        Float?
  payNote         String?

  applications JobApplication[]
  savedBy       SavedJob[]

  @@index([isActive, expiresAt])
  @@index([salonId, isActive])
  @@index([listingType, isActive])
}

model SavedJob {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       JobPost  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
  @@index([userId])
}

model SavedWorker {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workerId  String
  worker    WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, workerId])
  @@index([userId])
}

model JobApplication {
  id        String        @id @default(uuid())
  jobId     String
  job       JobPost       @relation(fields: [jobId], references: [id])
  workerId  String
  worker    WorkerProfile @relation(fields: [workerId], references: [id])
  status    AppStatus     @default(PENDING)
  createdAt DateTime      @default(now())
}

model PortfolioItem {
  id        String        @id @default(uuid())
  workerId  String
  worker    WorkerProfile @relation(fields: [workerId], references: [id])
  mediaUrl  String
  type      MediaType
  caption   String?
  createdAt DateTime      @default(now())
}

model Conversation {
  id           String                    @id @default(uuid())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
  chatRequest  ChatRequest?
  createdAt    DateTime                  @default(now())
}

model ConversationParticipant {
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  isArchived Boolean  @default(false)
  isPinned   Boolean  @default(false)
  isMuted    Boolean  @default(false)
  pinnedAt   DateTime?
  archivedAt DateTime?

  @@id([conversationId, userId])
  @@index([userId])
  @@index([userId, isArchived])
  @@index([userId, isPinned, pinnedAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  content        String?
  mediaUrl       String?
  audioUrl       String?
  duration       Int?
  waveformData   Json?
  type           String       @default("TEXT")
  status         String       @default("sent")
  createdAt      DateTime     @default(now())
  deliveredAt    DateTime?
  readAt         DateTime?
  isRead         Boolean      @default(false)
  isSystem       Boolean      @default(false)
  replyToId      String?
  replyTo        Message?     @relation("ReplyTo", fields: [replyToId], references: [id])
  replies        Message[]    @relation("ReplyTo")
  reactions      Json?
  isEdited       Boolean      @default(false)
  editedAt       DateTime?
  isDeletedForAll Boolean   @default(false)
  deletedAt      DateTime?
  deletedFor     DeletedMessage[]

  // Rich media fields
  mediaUrls      Json?        // string[] – multiple images (IMAGE type)
  thumbnailUrl   String?      // video thumbnail URL
  fileName       String?      // document filename
  fileSize       Int?         // file size in bytes
  mimeType       String?      // file MIME type
  contactName    String?      // CONTACT type
  contactPhone   String?
  latitude       Float?       // LOCATION type
  longitude      Float?
  locationName   String?

  @@index([conversationId, createdAt])
  @@index([conversationId, status])
  @@index([senderId, status])
  @@index([senderId, isRead])
  @@index([replyToId])
}

model DeletedMessage {
  id        String   @id @default(uuid())
  userId    String
  messageId String
  deletedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId])
  @@index([messageId])
}

model UserDevice {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  expoPushToken String
  platform      Platform
  updatedAt     DateTime @updatedAt

  @@unique([userId, expoPushToken])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model ChatRequest {
  id             String            @id @default(cuid())
  senderId       String
  receiverId     String
  status         ChatRequestStatus @default(PENDING)
  messageCount   Int               @default(0)
  conversationId String?           @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  sender         User              @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver       User              @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  conversation   Conversation?     @relation(fields: [conversationId], references: [id])

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
}

model Review {
  id        String    @id @default(cuid())
  rating    Int
  comment   String?
  reply     String?
  repliedAt DateTime?
  authorId  String
  subjectId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  author  User @relation("ReviewsWritten", fields: [authorId], references: [id], onDelete: Cascade)
  subject User @relation("ReviewsReceived", fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([authorId, subjectId])
  @@index([subjectId])
}

model Report {
  id         String       @id @default(uuid())
  reporterId String
  reporter   User         @relation("ReportGiver", fields: [reporterId], references: [id])
  reportedId String
  reported   User         @relation("ReportReceiver", fields: [reportedId], references: [id])
  type       ReportType
  reason     String?
  status     ReportStatus @default(PENDING)
  adminNote  String?
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime     @default(now())

  @@index([reportedId, status])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Story {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaUrl       String?
  type           MediaType
  caption        String?
  textContent    String?
  textBgColor    String?
  visibility     StoryVisibility  @default(PUBLIC)
  bookingEnabled Boolean          @default(false)
  location       String?
  mentions       String[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime?        @updatedAt
  expiresAt      DateTime

  views     StoryView[]
  likes     StoryLike[]
  replies   StoryReply[]

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model StoryView {
  id       String   @id @default(uuid())
  storyId  String
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewerId String
  viewer   User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([storyId, viewerId])
  @@index([storyId])
  @@index([viewerId])
}

model StoryLike {
  id        String   @id @default(uuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([storyId, userId])
  @@index([storyId])
}

model StoryReply {
  id        String   @id @default(uuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([storyId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  follower    User     @relation("FollowSource", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("FollowTarget", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())


  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// ─── Social Feed & Posts ──────────────────────────────────────────────────────

model Post {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           PostType
  caption        String?
  mediaUrls      String[]        @default([])
  beforeUrl      String?
  afterUrl       String?
  serviceId      String?
  visibility     StoryVisibility @default(PUBLIC)
  bookingEnabled Boolean         @default(false)
  likesCount     Int             @default(0)
  commentsCount  Int             @default(0)
  hashtags       PostHashtag[]
  likes          PostLike[]
  comments       Comment[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([visibility, createdAt])
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Comment {
  id        String    @id @default(uuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime  @default(now())

  @@index([postId, createdAt])
  @@index([parentId])
}

model Hashtag {
  id        String      @id @default(uuid())
  tag       String      @unique
  postCount Int         @default(0)
  posts     PostHashtag[]

  @@index([tag])
  @@index([postCount])
}

model PostHashtag {
  postId    String
  hashtagId String
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([postId, hashtagId])
  @@index([hashtagId])
}

model StoryHighlight {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  coverUrl  String?
  storyIds  String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AvailabilityException {
  id           String   @id @default(uuid())
  providerId   String
  providerType String
  date         String
  startTime    String?
  endTime      String?
  isBlocked    Boolean  @default(true)
  reason       String?
  createdAt    DateTime @default(now())

  @@index([providerId, providerType, date])
}

// ─── Phase 5: Booking Enhanced ────────────────────────────────────────────────

model IntakeForm {
  id           String          @id @default(uuid())
  providerId   String
  providerType String
  title        String
  description  String?
  questions    Json
  serviceIds   String[]        @default([])
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  responses    IntakeResponse[]

  @@index([providerId, providerType])
  @@index([providerId, providerType, isActive])
}

model IntakeResponse {
  id        String     @id @default(uuid())
  formId    String
  form      IntakeForm @relation(fields: [formId], references: [id])
  bookingId String     @unique
  booking   Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  answers   Json
  createdAt DateTime   @default(now())

  @@index([formId])
}

model Waitlist {
  id           String    @id @default(uuid())
  providerId   String
  providerType String
  serviceId    String
  date         String
  startTime    String
  clientUserId String?
  clientName   String
  clientEmail  String
  clientPhone  String?
  notes        String?
  notified     Boolean   @default(false)
  notifiedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([providerId, providerType, date, startTime])
  @@index([clientEmail])
}

// ─── Booking bridge (legacy — kept for migration safety) ──────────────────────

model ProviderBookingProfile {
  id                      String   @id @default(uuid())
  providerId              String
  providerType            String
  tenantSlug              String
  externalBookingSystemId String?
  isActive                Boolean  @default(true)
  providerEmail           String?
  providerPassword        String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([providerId, providerType])
  @@index([tenantSlug])
}

// ─── Native Booking Engine ────────────────────────────────────────────────────

model ProviderService {
  id           String    @id @default(uuid())
  providerId   String
  providerType String
  name         String
  description  String?
  duration     Int
  price        Float
  currency     String    @default("USD")
  category     String?
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)
  depositAmount Float?
  images       String[]  @default([])
  bufferBefore Int       @default(0)
  bufferAfter  Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookings     Booking[]

  @@index([providerId, providerType, isActive])
}

model ProviderAvailabilityRule {
  id           String   @id @default(uuid())
  providerId   String
  providerType String
  dayOfWeek    Int
  isOpen       Boolean  @default(true)
  openTime     String
  closeTime    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([providerId, providerType, dayOfWeek])
  @@index([providerId, providerType])
}

model Booking {
  id                   String          @id @default(uuid())
  providerId           String
  providerType         String
  serviceId            String
  service              ProviderService @relation(fields: [serviceId], references: [id])
  clientUserId         String?
  clientName           String
  clientEmail          String
  clientPhone          String?
  date                 String
  startTime            String
  endTime              String
  status               BookingStatus   @default(PENDING)
  price                Float
  currency             String          @default("USD")
  notes                String?
  providerNotes        String?
  cancelToken          String          @unique @default(cuid())
  rescheduleToken      String?         @unique @default(cuid())
  cancelTokenExpiresAt DateTime?
  confirmationCode     String?         @unique
  cancelReason         String?
  depositAmount        Float?
  depositPaid          Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  payment              BookingPayment?
  intakeResponse       IntakeResponse?

  @@unique([providerId, providerType, date, startTime])
  @@index([providerId, providerType, date])
  @@index([clientEmail, status])
  @@index([clientUserId, status])
  @@index([cancelToken])
  @@index([status, date])
}

model BookingPayment {
  id                    String    @id @default(uuid())
  bookingId             String    @unique
  booking               Booking   @relation(fields: [bookingId], references: [id])
  stripePaymentIntentId String?   @unique
  amount                Float
  currency              String    @default("USD")
  status                String    @default("pending")
  paidAt                DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([stripePaymentIntentId])
}
